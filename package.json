{
  "name": "romina-xv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "links:check": "node scripts/check-links.mjs",
    "derived:verify": "node scripts/verify-derived.mjs",
    "test:browser": "playwright test",
    "test:smoke": "node scripts/smoke-build.mjs",
    "media:verify": "node scripts/verify-built-media.mjs",
    "test:motion-dev": "playwright test --config playwright.dev.config.ts",
    "test:cross": "node scripts/run-cross-browser.mjs",
    "production:verify": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.1",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
